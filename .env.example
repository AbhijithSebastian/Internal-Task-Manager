# =============================================================================
# Internal Task Manager — Unified Environment Variables Template
# =============================================================================

# ─── APP CONFIGURATION ───────────────────────────────────────────────────────
APP_NAME="Internal Task Manager"
APP_ENV=development
APP_DEBUG=true

# ─── DATABASE CONFIGURATION ──────────────────────────────────────────────────
# Note: Use localhost if running backend directly, or 'postgres' if running via Docker
DATABASE_URL=postgresql+psycopg://taskmanager:taskmanager@postgres:5432/taskmanager

# ─── SECURITY & AUTHENTICATION ──────────────────────────────────────────────
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── CORS & PATHS ───────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_SIZE_MB=50
RATE_LIMIT_PER_MINUTE=60

# ─── CACHING & QUEUE (REDIS) ─────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ─── MAIL (SMTP) CONFIGURATION ───────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@internaltool.com
SMTP_FROM_NAME="Internal Task Manager"

# ─── FRONTEND URL ────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
